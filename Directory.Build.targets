<Project>
    <!--
        Per-package license selection. This must live in Directory.Build.targets (imported after the
        project body) so it can see the RegiraLicenseEnforced flag a csproj sets; Directory.Build.props
        is imported before the project body and would read it as empty.

        - Commercially licensed packages (Common.Licensing, Entities.EFcore,
          Entities.DependencyInjection, Entities.Web, Entities.Mapping.Mapster,
          Entities.Mapping.AutoMapper, Common.Office.Clients) ship the Regira Commercial License
          file (packed from legal\ by Directory.Build.props). The boundary is the paid product
          line, not the presence of validation code — Entities.EFcore validates nothing itself.
        - Every other package is Apache-2.0 via SPDX expression (no packed license file needed).

        PackageLicenseExpression and PackageLicenseFile are mutually exclusive per package; pack
        fails with NU5033 if both end up set, which guards against misconfiguration here.
    -->
    <PropertyGroup Condition="'$(RegiraLicenseEnforced)' == 'true'">
        <PackageLicenseFile>REGIRA-COMMERCIAL-LICENSE.md</PackageLicenseFile>
    </PropertyGroup>
    <PropertyGroup Condition="'$(RegiraLicenseEnforced)' != 'true'">
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <!-- The props default says "All rights reserved" — accurate for the commercial packages, a
             contradiction beside an Apache-2.0 grant (and license scanners flag the pair). -->
        <Copyright>Copyright (c) 2026 Regira bv</Copyright>
    </PropertyGroup>
    <!-- Apache-2.0 §4(d): a redistributor propagates NOTICE. The SPDX expression covers the license
         text for nuget.org, but NOTICE has no metadata slot — it has to travel as a packed file.
         Deliberately no Exists() guard: a missing NOTICE must fail the pack (NU5019), not silently
         ship an Apache package without its attribution file. -->
    <ItemGroup Condition="'$(RegiraLicenseEnforced)' != 'true' And '$(IsPackable)' != 'false'">
        <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="" Visible="false" />
    </ItemGroup>
</Project>
