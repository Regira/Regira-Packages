<Project>

  <PropertyGroup>
    <_RegiraOfficeFilesRoot>$(MSBuildThisFileDirectory)..\ai\</_RegiraOfficeFilesRoot>
    <!--
      Extract only when a solution context is present, so files land once at the
      solution root. Per-project builds (SolutionDir undefined) are skipped to
      avoid scattering duplicate copies into every consuming project folder.
    -->
    <_RegiraBaseDir Condition="'$(SolutionDir)' != '' And '$(SolutionDir)' != '*Undefined*'">$(SolutionDir)</_RegiraBaseDir>
  </PropertyGroup>

  <!--
    Copies Office AI instruction files into the consuming project's
    .regira/instructions/ folder on first build.
  -->
  <Target Name="RegiraOfficeExtractAiFiles"
          BeforeTargets="BeforeBuild"
          Condition="'$(_RegiraBaseDir)' != '' And !Exists('$(_RegiraBaseDir).regira\instructions\office.instructions.md')">

    <MakeDir Directories="$(_RegiraBaseDir).regira\instructions" />

    <Copy SourceFiles="$(_RegiraOfficeFilesRoot)office.instructions.md;$(_RegiraOfficeFilesRoot)office.namespaces.md;$(_RegiraOfficeFilesRoot)office.pdf.instructions.md;$(_RegiraOfficeFilesRoot)office.pdf.examples.md;$(_RegiraOfficeFilesRoot)office.excel.instructions.md;$(_RegiraOfficeFilesRoot)office.excel.examples.md;$(_RegiraOfficeFilesRoot)office.word.instructions.md;$(_RegiraOfficeFilesRoot)office.word.examples.md;$(_RegiraOfficeFilesRoot)office.mail.instructions.md;$(_RegiraOfficeFilesRoot)office.mail.examples.md;$(_RegiraOfficeFilesRoot)office.csv.instructions.md;$(_RegiraOfficeFilesRoot)office.csv.examples.md;$(_RegiraOfficeFilesRoot)office.barcodes.instructions.md;$(_RegiraOfficeFilesRoot)office.barcodes.examples.md;$(_RegiraOfficeFilesRoot)office.ocr.instructions.md;$(_RegiraOfficeFilesRoot)office.ocr.examples.md;$(_RegiraOfficeFilesRoot)office.vcards.instructions.md;$(_RegiraOfficeFilesRoot)office.vcards.examples.md"
          DestinationFolder="$(_RegiraBaseDir).regira\instructions\"
          SkipUnchangedFiles="true" />

  </Target>

</Project>
