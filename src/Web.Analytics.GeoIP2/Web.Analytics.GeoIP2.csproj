<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Web.Analytics.GeoIP2</RootNamespace>
    <PackageId>Regira.Web.Analytics.GeoIP2</PackageId>
    <AssemblyName>Regira.Web.Analytics.GeoIP2</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.2.0</Version>
    <Description>Geolocation enricher for Regira.Web.Analytics — resolves country and city from a local MaxMind GeoIP2/GeoLite2 database.</Description>
    <PackageTags>regira;web;analytics;geolocation;maxmind;geoip2;geolite2</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MaxMind.GeoIP2" Version="6.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Web.Analytics\Web.Analytics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Web.Analytics.GeoIP2.Testing" />
  </ItemGroup>
  <ItemGroup>
    <None Include="build\Regira.Web.Analytics.GeoIP2.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="build\Regira.Web.Analytics.GeoIP2.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="ai\web.analytics.geoip2.instructions.md" Pack="true" PackagePath="ai\" />
    <None Include="ai\web.analytics.geoip2.examples.md" Pack="true" PackagePath="ai\" />
  </ItemGroup>
</Project>