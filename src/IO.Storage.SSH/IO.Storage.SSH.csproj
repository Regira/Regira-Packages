<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.IO.Storage.SSH</RootNamespace>
    <PackageId>Regira.IO.Storage.SSH</PackageId>
    <AssemblyName>Regira.IO.Storage.SSH</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.1.0</Version>
    <Description>SFTP/SSH-based file storage implementation for Regira IO using SSH.NET.</Description>
    <PackageTags>regira;io;storage;ssh;sftp</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.IO.Storage\Common.IO.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Upgraded for vulnerabilities -->
    <!--<PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />-->
  </ItemGroup>
</Project>