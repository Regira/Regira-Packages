<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Office.VCards.FolkerKinzel</RootNamespace>
    <PackageId>Regira.Office.VCards.FolkerKinzel</PackageId>
    <AssemblyName>Regira.Office.VCards.FolkerKinzel</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.0.2</Version>
    <Description>vCard read/write support using FolkerKinzel.VCards for Regira Office.</Description>
    <PackageTags>regira;office;vcards;contacts;folkerkinzel</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.Office\Common.Office.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FolkerKinzel.VCards" Version="8.2.0" />
  </ItemGroup>
</Project>