<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Office.Mail.MailKit</RootNamespace>
    <PackageId>Regira.Office.Mail.MailKit</PackageId>
    <AssemblyName>Regira.Office.Mail.MailKit</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.6.0</Version>
    <Description>Mail sending to any SMTP server via MailKit for Regira Office.</Description>
    <PackageTags>regira;office;mail;smtp;mailkit;email</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Office.Mail.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.Office\Common.Office.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- MimeKit 4.18.1 floors System.Security.Cryptography.Pkcs at 10.0.0 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <None Include="ai\mail.mailkit.card.md" Pack="true" PackagePath="ai\" />
  </ItemGroup>
</Project>