<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Office.Word.Syncfusion</RootNamespace>
    <PackageId>Regira.Office.Word.Syncfusion</PackageId>
    <AssemblyName>Regira.Office.Word.Syncfusion</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.6.1</Version>
    <Description>Word document processing using Syncfusion DocIO for Regira Office.</Description>
    <PackageTags>regira;office;word;syncfusion;docio;docx</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Syncfusion.DocIO.Net.Core" Version="35.1.40" />
    <!-- SkiaSharp-based renderer: required for PDF conversion and page rasterization -->
    <PackageReference Include="Syncfusion.DocIORenderer.Net.Core" Version="35.1.40" />
    <!-- Syncfusion 35.1.40 floors System.Security.Cryptography.Xml at 10.0.11, and with it Pkcs (GHSA-r955-8q5j-3h83, GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj, GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.Office\Common.Office.csproj" />
  </ItemGroup>
</Project>