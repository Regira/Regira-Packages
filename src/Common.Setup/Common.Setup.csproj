<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Setup</RootNamespace>
    <PackageId>Regira.Setup</PackageId>
    <AssemblyName>Regira.Setup</AssemblyName>
    <Description>Shared Regira setup guides and AI instruction extraction support for consumer projects.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.1.3</Version>
    <PackageTags>regira;setup;ai;guides;mcp;ai-agents</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="build\Regira.Setup.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="build\Regira.Setup.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="ai\project.setup.md" Pack="true" PackagePath="ai\" />
    <None Include="ai\shared.setup.md" Pack="true" PackagePath="ai\" />
    <None Include="ai\CLAUDE.md" Pack="true" PackagePath="ai\" />
    <None Include="ai\copilot-instructions.md" Pack="true" PackagePath="ai\" />
    <None Include="ai\commands\new-project.md" Pack="true" PackagePath="ai\commands\" />
    <None Include="ai\commands\new-entity.md" Pack="true" PackagePath="ai\commands\" />
    <None Include="ai\commands\sync-guides.md" Pack="true" PackagePath="ai\commands\" />
    <None Include="ai\commands\evaluate.md" Pack="true" PackagePath="ai\commands\" />
  </ItemGroup>
</Project>