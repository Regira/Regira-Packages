<Project>

  <PropertyGroup>
    <_RegiraSetupFilesRoot>$(MSBuildThisFileDirectory)..\ai\</_RegiraSetupFilesRoot>
    <!--
      Extract only when a solution context is present, so files land once at the
      solution root. Per-project builds (SolutionDir undefined) are skipped to
      avoid scattering duplicate copies into every consuming project folder.
    -->
    <_RegiraBaseDir Condition="'$(SolutionDir)' != '' And '$(SolutionDir)' != '*Undefined*'">$(SolutionDir)</_RegiraBaseDir>
  </PropertyGroup>

  <!--
    Copies shared Regira setup guides into the consuming project's
    .regira/instructions/ folder. Existing files are left untouched; missing ones are copied on the next build.
  -->
  <Target Name="RegiraSetupExtractAiFiles"
          BeforeTargets="BeforeBuild"
          Condition="'$(_RegiraBaseDir)' != ''">

    <!-- Per-file gating: a file the consumer already has is never overwritten, and a guide
         added by a package upgrade still lands — a single already-extracted sentinel would
         skip the whole copy and new guides would never reach an existing solution. -->
    <ItemGroup>
      <!-- This ai\ folder is the one heterogeneous one: copilot-instructions.md has its own target
           (.github\instructions\, below) and CLAUDE.md only functions at a solution root — neither
           belongs in .regira\instructions\, so they are excluded from the glob rather than duplicated. -->
      <_RegiraSetupExtractAiFilesFile Include="$(_RegiraSetupFilesRoot)*.md"
                                      Exclude="$(_RegiraSetupFilesRoot)CLAUDE.md;$(_RegiraSetupFilesRoot)copilot-instructions.md" />
      <_RegiraSetupExtractAiFilesFileMissing Include="@(_RegiraSetupExtractAiFilesFile)" Condition="!Exists('$(_RegiraBaseDir).regira\instructions\%(Filename)%(Extension)')" />
    </ItemGroup>

    <MakeDir Directories="$(_RegiraBaseDir).regira\instructions" Condition="'@(_RegiraSetupExtractAiFilesFileMissing)' != ''" />

    <Copy SourceFiles="@(_RegiraSetupExtractAiFilesFileMissing)"
          DestinationFolder="$(_RegiraBaseDir).regira\instructions\"
          Condition="'@(_RegiraSetupExtractAiFilesFileMissing)' != ''" />

  </Target>

  <!--
    Copies copilot-instructions.md into the consuming project's
    .github/instructions/ folder on first build, giving VS Code Copilot
    Regira-aware context without any manual setup.
  -->
  <Target Name="RegiraSetupExtractCopilotInstructions"
          BeforeTargets="BeforeBuild"
          Condition="'$(_RegiraBaseDir)' != ''">

    <!-- Per-file gating: a file the consumer already has is never overwritten, and a guide
         added by a package upgrade still lands — a single already-extracted sentinel would
         skip the whole copy and new guides would never reach an existing solution. -->
    <ItemGroup>
      <_RegiraSetupExtractCopilotInstructionsFile Include="$(_RegiraSetupFilesRoot)copilot-instructions.md" />
      <_RegiraSetupExtractCopilotInstructionsFileMissing Include="@(_RegiraSetupExtractCopilotInstructionsFile)" Condition="!Exists('$(_RegiraBaseDir).github\instructions\%(Filename)%(Extension)')" />
    </ItemGroup>

    <MakeDir Directories="$(_RegiraBaseDir).github\instructions" Condition="'@(_RegiraSetupExtractCopilotInstructionsFileMissing)' != ''" />

    <Copy SourceFiles="@(_RegiraSetupExtractCopilotInstructionsFileMissing)"
          DestinationFolder="$(_RegiraBaseDir).github\instructions\"
          Condition="'@(_RegiraSetupExtractCopilotInstructionsFileMissing)' != ''" />

  </Target>

  <!--
    Copies Regira slash commands into the consuming project's
    .claude/commands/ folder. Existing files are left untouched; missing ones are copied on the next build.
  -->
  <Target Name="RegiraSetupExtractCommandFiles"
          BeforeTargets="BeforeBuild"
          Condition="'$(_RegiraBaseDir)' != ''">

    <!-- Per-file gating: a file the consumer already has is never overwritten, and a guide
         added by a package upgrade still lands — a single already-extracted sentinel would
         skip the whole copy and new guides would never reach an existing solution. -->
    <ItemGroup>
      <_RegiraSetupExtractCommandFilesFile Include="$(_RegiraSetupFilesRoot)commands\*.md" />
      <_RegiraSetupExtractCommandFilesFileMissing Include="@(_RegiraSetupExtractCommandFilesFile)" Condition="!Exists('$(_RegiraBaseDir).claude\commands\%(Filename)%(Extension)')" />
    </ItemGroup>

    <MakeDir Directories="$(_RegiraBaseDir).claude\commands" Condition="'@(_RegiraSetupExtractCommandFilesFileMissing)' != ''" />

    <Copy SourceFiles="@(_RegiraSetupExtractCommandFilesFileMissing)"
          DestinationFolder="$(_RegiraBaseDir).claude\commands\"
          Condition="'@(_RegiraSetupExtractCommandFilesFileMissing)' != ''" />

  </Target>

</Project>
