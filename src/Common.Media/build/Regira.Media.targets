<Project>

  <PropertyGroup>
    <_RegiraMediaFilesRoot>$(MSBuildThisFileDirectory)..\ai\</_RegiraMediaFilesRoot>
    <_RegiraBaseDir Condition="'$(SolutionDir)' != '' And '$(SolutionDir)' != '*Undefined*'">$(SolutionDir)</_RegiraBaseDir>
    <_RegiraBaseDir Condition="'$(_RegiraBaseDir)' == ''">$(ProjectDir)</_RegiraBaseDir>
  </PropertyGroup>

  <!--
    Copies Media AI instruction files into the consuming project's
    .regira/instructions/ folder. Existing files are left untouched; missing ones are copied on the next build.
  -->
  <Target Name="RegiraMediaExtractAiFiles"
          BeforeTargets="BeforeBuild">

    <!-- Per-file gating: a file the consumer already has is never overwritten, and a guide
         added by a package upgrade still lands — a single already-extracted sentinel would
         skip the whole copy and new guides would never reach an existing solution. -->
    <ItemGroup>
      <_RegiraMediaExtractAiFilesFile Include="$(_RegiraMediaFilesRoot)*.md" />
      <_RegiraMediaExtractAiFilesFileMissing Include="@(_RegiraMediaExtractAiFilesFile)" Condition="!Exists('$(_RegiraBaseDir).regira\instructions\%(Filename)%(Extension)')" />
    </ItemGroup>

    <MakeDir Directories="$(_RegiraBaseDir).regira\instructions" Condition="'@(_RegiraMediaExtractAiFilesFileMissing)' != ''" />

    <Copy SourceFiles="@(_RegiraMediaExtractAiFilesFileMissing)"
          DestinationFolder="$(_RegiraBaseDir).regira\instructions\"
          Condition="'@(_RegiraMediaExtractAiFilesFileMissing)' != ''" />

  </Target>

</Project>
