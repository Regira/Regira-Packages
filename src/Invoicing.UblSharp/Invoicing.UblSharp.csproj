<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Invoicing.UblSharp</RootNamespace>
    <PackageId>Regira.Invoicing.UblSharp</PackageId>
    <AssemblyName>Regira.Invoicing.UblSharp</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.0.1</Version>
    <Description>UBL (Universal Business Language) invoice serialization using UblSharp for Regira.</Description>
    <PackageTags>regira;invoicing;ubl;xml;ublsharp</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="UblSharp" Version="1.1.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.Invoicing\Common.Invoicing.csproj" />
  </ItemGroup>
</Project>