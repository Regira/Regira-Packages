<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira</RootNamespace>
    <PackageId>Regira.Common</PackageId>
    <AssemblyName>Regira.Common</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.1.2</Version>
    <Description>Core utility types and extension methods shared across all Regira packages.</Description>
    <PackageTags>regira;common;utilities;extensions</PackageTags>
  </PropertyGroup>
</Project>