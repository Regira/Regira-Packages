<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Office.Clients</RootNamespace>
    <PackageId>Regira.Office.Clients</PackageId>
    <AssemblyName>Regira.Office.Clients</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.1.2</Version>
    <RegiraLicenseEnforced>true</RegiraLicenseEnforced>
    <Description>HTTP client extensions for consuming Regira Office services remotely. Free tier included — a license key removes the free-tier limits.</Description>
    <PackageTags>regira;office;clients;http</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.Licensing\Common.Licensing.csproj" />
    <ProjectReference Include="..\Common.Office\Common.Office.csproj" />
  </ItemGroup>
</Project>