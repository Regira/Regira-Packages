<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Entities</RootNamespace>
    <PackageId>Regira.Entities</PackageId>
    <AssemblyName>Regira.Entities</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.2.0</Version>
    <Description>Abstractions and base types for the Regira CRUD entity framework.</Description>
    <PackageTags>regira;entities;crud;data;model;filtering;sorting;search;pagination;repository;abstractions;mcp;ai-agents</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.IO.Storage\Common.IO.Storage.csproj" />
    <ProjectReference Include="..\Common\Common.csproj" />
  </ItemGroup>
  <!-- MSBuild targets — auto-imported into consuming builds via NuGet buildTransitive -->
  <ItemGroup>
    <None Include="build\Regira.Entities.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="build\Regira.Entities.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
  <!-- AI instruction files -->
  <ItemGroup>
    <None Include="ai\entities.card.md" Pack="true" PackagePath="ai\" />
    <None Include="ai\entities.instructions.md" Pack="true" PackagePath="ai\" />
    <None Include="ai\entities.setup.md" Pack="true" PackagePath="ai\" />
    <None Include="ai\entities.examples.md" Pack="true" PackagePath="ai\" />
    <None Include="ai\entities.patterns.md" Pack="true" PackagePath="ai\" />
    <None Include="ai\entities.blueprints.md" Pack="true" PackagePath="ai\" />
    <None Include="ai\entities.signatures.md" Pack="true" PackagePath="ai\" />
    <None Include="ai\entities.namespaces.md" Pack="true" PackagePath="ai\" />
    <None Include="ai\entities.advanced.example.md" Pack="true" PackagePath="ai\" />
  </ItemGroup>
</Project>