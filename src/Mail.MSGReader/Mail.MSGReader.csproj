<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Office.Mail.MSGReader</RootNamespace>
    <PackageId>Regira.Office.Mail.MSGReader</PackageId>
    <AssemblyName>Regira.Office.Mail.MSGReader</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.6.1</Version>
    <Description>MSG and EML file reading using MsgReader for Regira Office.</Description>
    <PackageTags>regira;office;mail;msg;msgreader;email</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MsgReader" Version="6.2.0" />
    <!-- MsgReader 6.2.0 floors System.Security.Cryptography.Pkcs at 10.0.12 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.Office\Common.Office.csproj" />
  </ItemGroup>
</Project>