<Project>

  <PropertyGroup>
    <_RegiraSystemFilesRoot>$(MSBuildThisFileDirectory)..\ai\</_RegiraSystemFilesRoot>
    <_RegiraBaseDir Condition="'$(SolutionDir)' != '' And '$(SolutionDir)' != '*Undefined*'">$(SolutionDir)</_RegiraBaseDir>
    <_RegiraBaseDir Condition="'$(_RegiraBaseDir)' == ''">$(ProjectDir)</_RegiraBaseDir>
  </PropertyGroup>

  <!--
    Copies System AI instruction files into the consuming project's
    .regira/instructions/ folder. Existing files are left untouched; missing ones are copied on the next build.
  -->
  <Target Name="RegiraSystemExtractAiFiles"
          BeforeTargets="BeforeBuild">

    <!-- Per-file gating: a file the consumer already has is never overwritten, and a guide
         added by a package upgrade still lands — a single already-extracted sentinel would
         skip the whole copy and new guides would never reach an existing solution. -->
    <ItemGroup>
      <_RegiraSystemExtractAiFilesFile Include="$(_RegiraSystemFilesRoot)*.md" />
      <_RegiraSystemExtractAiFilesFileMissing Include="@(_RegiraSystemExtractAiFilesFile)" Condition="!Exists('$(_RegiraBaseDir).regira\instructions\%(Filename)%(Extension)')" />
    </ItemGroup>

    <MakeDir Directories="$(_RegiraBaseDir).regira\instructions" Condition="'@(_RegiraSystemExtractAiFilesFileMissing)' != ''" />

    <Copy SourceFiles="@(_RegiraSystemExtractAiFilesFileMissing)"
          DestinationFolder="$(_RegiraBaseDir).regira\instructions\"
          Condition="'@(_RegiraSystemExtractAiFilesFileMissing)' != ''" />

  </Target>

</Project>
