<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- net11.0 is built by an SDK that can target it. -->
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">$(TargetFrameworks);net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.System</RootNamespace>
    <PackageId>Regira.System</PackageId>
    <AssemblyName>Regira.System</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.7.0</Version>
    <Description>Runs external processes and captures their output (IProcessHelper), and holds the job scheduling contract (IJobHandler, IJobScheduler, CronSchedule). Hub of the system guides, which also cover Regira.System.Hosting, Regira.System.Projects and the scheduling adapters.</Description>
    <PackageTags>regira;system;utilities;process;scheduling;jobs</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
  </ItemGroup>
  <!-- MSBuild targets — auto-imported into consuming builds via NuGet buildTransitive -->
  <ItemGroup>
    <None Include="build\Regira.System.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="build\Regira.System.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
  <!-- AI instruction files -->
  <ItemGroup>
    <None Include="ai\system.instructions.md" Pack="true" PackagePath="ai\" />
    <None Include="ai\system.examples.md" Pack="true" PackagePath="ai\" />
  </ItemGroup>
</Project>