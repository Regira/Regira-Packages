<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Office.PDF.Gotenberg</RootNamespace>
    <PackageId>Regira.Office.PDF.Gotenberg</PackageId>
    <AssemblyName>Regira.Office.PDF.Gotenberg</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.6.0</Version>
    <Description>HTML to PDF conversion through the Chromium route of a Gotenberg server for Regira Office.</Description>
    <PackageTags>regira;office;pdf;gotenberg;chromium;html-to-pdf</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.Office\Common.Office.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Office.PDF.Testing" />
  </ItemGroup>
  <ItemGroup>
    <None Include="ai\pdf.gotenberg.card.md" Pack="true" PackagePath="ai\" />
  </ItemGroup>
</Project>