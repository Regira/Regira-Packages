<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Payments.Mollie</RootNamespace>
    <PackageId>Regira.Payments.Mollie</PackageId>
    <AssemblyName>Regira.Payments.Mollie</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.1.1</Version>
    <Description>Mollie payment gateway integration for Regira.</Description>
    <PackageTags>regira;payments;mollie;gateway</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Abstractions\**" />
    <EmbeddedResource Remove="Abstractions\**" />
    <None Remove="Abstractions\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Mollie.Api" Version="4.20.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.Invoicing\Common.Invoicing.csproj" />
  </ItemGroup>
</Project>