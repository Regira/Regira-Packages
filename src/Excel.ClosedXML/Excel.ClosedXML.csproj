<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Office.Excel.ClosedXML</RootNamespace>
    <PackageId>Regira.Office.Excel.ClosedXML</PackageId>
    <AssemblyName>Regira.Office.Excel.ClosedXML</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.1.3</Version>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>Excel spreadsheet reading and writing (import/export) using ClosedXML for Regira Office.</Description>
    <PackageTags>regira;office;excel;spreadsheet;import;export;closedxml</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="ClosedXML.Parser" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.Office\Common.Office.csproj" />
  </ItemGroup>
</Project>