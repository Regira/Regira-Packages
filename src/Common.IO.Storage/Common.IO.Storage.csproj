<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.IO.Storage</RootNamespace>
    <PackageId>Regira.IO.Storage</PackageId>
    <AssemblyName>Regira.IO.Storage</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.7.0</Version>
    <Description>Store, list, read and delete files and folders behind one IFileService, for Regira: on the local file system or in a ZIP archive, and on Azure Blob Storage, SFTP or GitHub through the provider packages.</Description>
    <PackageTags>regira;io;storage;file-storage;files;blobs;attachments;zip;disk;download</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Regira.IO.Storage.Azure" />
    <InternalsVisibleTo Include="Regira.IO.Storage.GitHub" />
    <InternalsVisibleTo Include="Regira.IO.Storage.SSH" />
    <InternalsVisibleTo Include="IO.Testing" />
  </ItemGroup>
  <!-- MSBuild targets — auto-imported into consuming builds via NuGet buildTransitive -->
  <ItemGroup>
    <None Include="build\Regira.IO.Storage.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="build\Regira.IO.Storage.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
  <!-- AI instruction files -->
  <ItemGroup>
    <None Include="ai\io.storage.card.md" Pack="true" PackagePath="ai\" />
    <None Include="ai\io.storage.instructions.md" Pack="true" PackagePath="ai\" />
    <None Include="ai\io.storage.namespaces.md" Pack="true" PackagePath="ai\" />
    <None Include="ai\io.storage.examples.md" Pack="true" PackagePath="ai\" />
  </ItemGroup>
</Project>