  <ItemGroup>
    <ProjectReference Include="..\Common.IO.Storage\Common.IO.Storage.csproj" />
    <ProjectReference Include="..\Common.System\Common.System.csproj" />
    <ProjectReference Include="..\TreeList\TreeList.csproj" />
