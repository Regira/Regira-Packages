<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.IO.Storage.SimpleTCP</RootNamespace>
    <PackageId>Regira.IO.Storage.SimpleTCP</PackageId>
    <AssemblyName>Regira.IO.Storage.SimpleTCP</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.6.1</Version>
    <Description>Writes bytes or text to a raw TCP port through ITextFileService, such as a ZPL label to a network label printer on port 9100, or a message to a socket listener.</Description>
    <PackageTags>regira;io;storage;tcp;simpletcp;socket;raw;printer;label;zpl</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.IO.Storage\Common.IO.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SimpleTCP.Core" Version="1.0.4" />
  </ItemGroup>
</Project>