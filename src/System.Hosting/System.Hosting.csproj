<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- net11.0 is built by an SDK that can target it. -->
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">$(TargetFrameworks);net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.System.Hosting</RootNamespace>
    <PackageId>Regira.System.Hosting</PackageId>
    <AssemblyName>Regira.System.Hosting</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.7.0</Version>
    <Description>Generic Host extensions for Regira: host options, background task queues, in-process job scheduling (run now, once at a time, or on a cron schedule) and Windows Service support.</Description>
    <PackageTags>regira;system;hosting;windowsservice;generichost;scheduling;cron;jobs</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.System\Common.System.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Hosting.Testing" />
  </ItemGroup>
</Project>