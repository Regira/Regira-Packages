<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Office.Excel.MiniExcel</RootNamespace>
    <PackageId>Regira.Office.Excel.MiniExcel</PackageId>
    <AssemblyName>Regira.Office.Excel.MiniExcel</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.1.3</Version>
    <Description>Excel spreadsheet reading and writing (import/export) using MiniExcel for Regira Office.</Description>
    <PackageTags>regira;office;excel;spreadsheet;import;export;miniexcel</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MiniExcel" Version="1.45.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.Office\Common.Office.csproj" />
  </ItemGroup>
</Project>