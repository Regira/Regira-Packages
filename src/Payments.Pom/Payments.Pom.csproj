<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Payments.Pom</RootNamespace>
    <PackageId>Regira.Payments.Pom</PackageId>
    <AssemblyName>Regira.Payments.Pom</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.1.2</Version>
    <Description>POM payment integration for Regira.</Description>
    <PackageTags>regira;payments;pom</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.Invoicing\Common.Invoicing.csproj" />
  </ItemGroup>
</Project>