<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Entities.DependencyInjection</RootNamespace>
    <PackageId>Regira.Entities.DependencyInjection</PackageId>
    <AssemblyName>Regira.Entities.DependencyInjection</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.0.0</Version>
    <Description>Dependency injection extensions for Regira's entity library.</Description>
    <PackageTags>regira;entities;dependency-injection;di;registration;service-collection;crud;console;worker</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).xml" Pack="true" PackagePath="lib\$(TargetFramework)\" Visible="false" Condition="Exists('$(OutputPath)$(AssemblyName).xml')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.Licensing\Common.Licensing.csproj" />
    <ProjectReference Include="..\Entities.EFcore\Entities.EFcore.csproj" />
  </ItemGroup>
</Project>