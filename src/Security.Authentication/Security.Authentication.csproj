<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Security.Authentication</RootNamespace>
    <PackageId>Regira.Security.Authentication</PackageId>
    <AssemblyName>Regira.Security.Authentication</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.0.2</Version>
    <Description>JWT and OAuth2 authentication helpers using Duende IdentityModel for Regira.</Description>
    <PackageTags>regira;security;authentication;jwt;oauth2</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Duende.IdentityModel" Version="8.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.Security\Common.Security.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- Lets the tests assert option shaping (authority, audiences, issuer list) directly, which is what covers
         the values a live host would fetch metadata from — the metadata request itself cannot be made in-process.
         Debug-only so the attribute does not ship in the packed (Release) assembly. -->
    <InternalsVisibleTo Include="Web.Security.Testing" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework) == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.28" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.28" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework) == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <None Include="ai\authentication.card.md" Pack="true" PackagePath="ai\" />
  </ItemGroup>
</Project>