<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Web.HTML.RazorEngineCore</RootNamespace>
    <PackageId>Regira.Web.HTML.RazorEngineCore</PackageId>
    <AssemblyName>Regira.Web.HTML.RazorEngineCore</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.1.3</Version>
    <Description>Razor-based HTML template rendering using RazorEngineCore for Regira.</Description>
    <PackageTags>regira;web;html;razor;templates</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RazorEngineCore" Version="2026.1.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.Web\Common.Web.csproj" />
  </ItemGroup>
</Project>