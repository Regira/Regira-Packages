<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Web.Analytics</RootNamespace>
    <PackageId>Regira.Web.Analytics</PackageId>
    <AssemblyName>Regira.Web.Analytics</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.2.1</Version>
    <Description>Abstract visitor analytics for ASP.NET Core — collects page views and hands them to consumer-registered enrichment and persistence hooks.</Description>
    <PackageTags>regira;web;analytics;tracking;middleware</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.Web\Common.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="build\Regira.Web.Analytics.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="build\Regira.Web.Analytics.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="ai\web.analytics.instructions.md" Pack="true" PackagePath="ai\" />
    <None Include="ai\web.analytics.examples.md" Pack="true" PackagePath="ai\" />
  </ItemGroup>
</Project>