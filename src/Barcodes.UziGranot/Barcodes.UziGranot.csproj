<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Office.Barcodes.UziGranot</RootNamespace>
    <PackageId>Regira.Office.Barcodes.UziGranot</PackageId>
    <AssemblyName>Regira.Office.Barcodes.UziGranot</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.6.1</Version>
    <Description>Barcode generation using the UziGranot library for Regira Office. Windows only (GDI+): for a cross-platform app use Regira.Office.Barcodes.ZXing.</Description>
    <PackageTags>regira;office;barcodes;uzigranot;windows</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.Office\Common.Office.csproj" />
    <ProjectReference Include="..\Drawing.GDI\Drawing.GDI.csproj" />
  </ItemGroup>
</Project>