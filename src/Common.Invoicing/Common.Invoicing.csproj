<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Invoicing</RootNamespace>
    <PackageId>Regira.Invoicing</PackageId>
    <AssemblyName>Regira.Invoicing</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.0.2</Version>
    <Description>Abstractions for invoicing workflows in Regira.</Description>
    <PackageTags>regira;invoicing;billing</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
  </ItemGroup>
  <!-- MSBuild targets — auto-imported into consuming builds via NuGet buildTransitive -->
  <ItemGroup>
    <None Include="build\Regira.Invoicing.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="build\Regira.Invoicing.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
  <!-- AI instruction files -->
  <ItemGroup>
    <None Include="ai\invoicing.instructions.md" Pack="true" PackagePath="ai\" />
    <None Include="ai\invoicing.examples.md" Pack="true" PackagePath="ai\" />
  </ItemGroup>
</Project>