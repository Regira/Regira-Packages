<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Regira bv</Authors>
    <RootNamespace>Regira.Drawing.SkiaSharp</RootNamespace>
    <PackageId>Regira.Drawing.SkiaSharp</PackageId>
    <AssemblyName>Regira.Drawing.SkiaSharp</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
    <Version>6.2.0</Version>
    <Description>SkiaSharp-based image processing and drawing utilities for Regira.</Description>
    <PackageTags>regira;drawing;skiasharp;images</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.151.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common.Media\Common.Media.csproj" />
  </ItemGroup>
</Project>