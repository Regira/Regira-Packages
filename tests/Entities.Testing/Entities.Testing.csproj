<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- both shipped EF majors: net8.0 → EF Core 9, net10.0 → EF Core 10 (the DbContext wiring is EF-version-sensitive) -->
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- NUnit 4 overload disambiguation (OverloadResolutionPriority) needs C# 13+, also on net8.0 -->
        <LangVersion>latest</LangVersion>

        <IsPackable>false</IsPackable>

        <Description>Unit and integration tests for the Regira entity framework.</Description>
        <PackageTags>regira;testing;entities</PackageTags>
</PropertyGroup>

    <ItemGroup Condition="$(TargetFramework) == 'net8.0'">
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.21" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.21" />
    </ItemGroup>
    <ItemGroup Condition="$(TargetFramework) == 'net10.0'">
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageReference Include="NUnit" Version="5.0.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
        <PackageReference Include="NUnit.Analyzers" Version="4.15.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector" Version="10.1.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\Entities.DependencyInjection\Entities.DependencyInjection.csproj" />
      <!-- the JSON options beside AddProblemDetails(), on both frameworks (ProblemDetailsJsonTests) -->
      <ProjectReference Include="..\..\src\Entities.Web\Entities.Web.csproj" />
      <ProjectReference Include="..\..\src\Entities.Validation.FluentValidation\Entities.Validation.FluentValidation.csproj" />
      <ProjectReference Include="..\Testing.Library\_Testing.Library.csproj" />
    </ItemGroup>

</Project>
