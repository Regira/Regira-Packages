<p>@Model.Title</p>

@code {
    [Parameter, EditorRequired] public Order Model { get; set; } = null!;

    protected override void OnInitialized()
    {
        if (Model.OrderLines == null || Model.OrderLines.Count == 0)
        {
            throw new ArgumentException("An order needs at least one order line.", nameof(Model));
        }
    }
}
